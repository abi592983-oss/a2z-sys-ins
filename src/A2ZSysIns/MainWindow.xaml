<Window x:Class="A2ZSysIns.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A2Z System Inspector" Width="1120" Height="760" MinWidth="900" MinHeight="620" Background="#F4F7FA" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Navy}" Padding="24,12"><DockPanel><TextBlock Text="A2Z SYSTEM INSPECTOR" Foreground="White" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="Read-only PC health inspection" Foreground="#B9D6F2" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel></Border>
    <TabControl x:Name="Tabs" Grid.Row="1" Margin="18" Background="White">
      <TabItem Header="1  Inspection details"><ScrollViewer><Grid Margin="28" MaxWidth="760" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="480"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="Start a new inspection" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock Grid.Row="1" Text="Customer / reference" VerticalAlignment="Center"/><TextBox x:Name="CustomerBox" Grid.Row="1" Grid.Column="1"/>
        <TextBlock Grid.Row="2" Text="Job number (optional)" VerticalAlignment="Center"/><TextBox x:Name="JobBox" Grid.Row="2" Grid.Column="1"/>
        <TextBlock Grid.Row="3" Text="Technician" VerticalAlignment="Center"/><TextBox x:Name="TechnicianBox" Grid.Row="3" Grid.Column="1"/>
        <TextBlock Grid.Row="4" Text="Reported problem" VerticalAlignment="Top" Margin="0,12,0,0"/><TextBox x:Name="ProblemBox" Grid.Row="4" Grid.Column="1" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="StartButton" Content="Start read-only inspection" Click="Start_Click"/><TextBlock Text="Some readings require administrator access." Foreground="DimGray" VerticalAlignment="Center" Margin="14,0"/></StackPanel>
      </Grid></ScrollViewer></TabItem>
      <TabItem Header="2  Progress"><StackPanel Margin="35" MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="Inspection in progress" FontSize="22" FontWeight="SemiBold"/><ProgressBar x:Name="Progress" Height="20" Margin="0,24,0,10" Minimum="0" Maximum="100"/><TextBlock x:Name="ProgressText" Text="Ready" FontSize="15"/><TextBlock Text="The application only reads diagnostic information. It does not repair, delete, clean, update, or modify this computer." TextWrapping="Wrap" Foreground="DimGray" Margin="0,30,0,0"/></StackPanel></TabItem>
      <TabItem Header="3  Results"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock x:Name="OverallText" Text="No inspection completed" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="InspectionIdText" HorizontalAlignment="Right" Foreground="DimGray"/></DockPanel><ListView x:Name="ResultsList" Grid.Row="1" Margin="0,18"><ListView.View><GridView><GridViewColumn Header="Category" Width="180" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="Score" Width="90" DisplayMemberBinding="{Binding Score}"/><GridViewColumn Header="Status" Width="150" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Reason" Width="520" DisplayMemberBinding="{Binding Reason}"/></GridView></ListView.View></ListView><StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="View report" Click="ViewReport_Click"/><Button Content="Export JSON evidence" Click="ExportJson_Click"/><Button Content="Save text summary" Click="ExportText_Click"/><Button Content="New inspection" Click="New_Click" Background="#546E7A"/></StackPanel></Grid></TabItem>
      <TabItem Header="4  Report"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><FlowDocumentScrollViewer x:Name="ReportViewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10"><Button Content="Print / Save as PDF" Click="Print_Click"/><Button Content="Export JSON evidence" Click="ExportJson_Click"/></StackPanel></Grid></TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#E6EEF6" Padding="18,8"><DockPanel><TextBlock x:Name="StatusText" Text="Ready"/><TextBlock Text="Version 1.0 • Windows 7 SP1 / 10 / 11 • Offline" HorizontalAlignment="Right" Foreground="DimGray"/></DockPanel></Border>
  </Grid>
</Window>
