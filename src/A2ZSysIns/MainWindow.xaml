<Window x:Class="A2ZSysIns.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A2Z System Inspector — Technician Console" Width="1440" Height="900" MinWidth="840" MinHeight="600" Background="#06111F" Foreground="#EAF2FF" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
<Window.Resources>
<SolidColorBrush x:Key="Panel" Color="#091A2D"/><SolidColorBrush x:Key="PanelRaised" Color="#0C2137"/><SolidColorBrush x:Key="Line" Color="#1A4266"/><SolidColorBrush x:Key="Blue" Color="#1688FF"/><SolidColorBrush x:Key="Green" Color="#36D88A"/><SolidColorBrush x:Key="Muted" Color="#8DA5C1"/>
<Style x:Key="Glyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="18"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="14"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#0D2640"/><Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="BorderBrush" Value="#245278"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#16436C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#0A5FB9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Background" Value="#102136"/><Setter TargetName="Shell" Property="BorderBrush" Value="#25415D"/><Setter Property="Foreground" Value="#7187A0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#087DF5"/><Setter Property="BorderBrush" Value="#3FA8FF"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#381827"/><Setter Property="BorderBrush" Value="#B9405E"/></Style>
<Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="13,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="14"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#102C49"/></Trigger></Style.Triggers></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#061525"/><Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="BorderBrush" Value="#245278"/><Setter Property="Padding" Value="9"/></Style>
<Style TargetType="ComboBox"><Setter Property="Background" Value="#0C2137"/><Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="BorderBrush" Value="#245278"/><Setter Property="Padding" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"><Grid><ContentPresenter Margin="9,0,30,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Path Data="M 0 0 L 8 0 L 4 5 Z" Fill="#A8C4E0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Grid></Border></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Slide"><Border Background="#0C2137" BorderBrush="#245278" BorderThickness="1" CornerRadius="3" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Background" Value="#102136"/><Setter Property="Foreground" Value="#7187A0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#0C2137"/><Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="Padding" Value="9,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemShell" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="#16436C"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="#123D68"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="#91A8C2"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabShell" Background="{TemplateBinding Background}" BorderBrush="#1A4266" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabShell" Property="Background" Value="#123D68"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabShell" Property="Background" Value="#102C49"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#0E2944"/><Setter Property="Foreground" Value="#C7DBF3"/><Setter Property="BorderBrush" Value="#1A4266"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style x:Key="FullPageTabs" TargetType="{x:Type TabControl}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TabControl}"><Border Background="Transparent"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid Background="#071422">
<Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="37"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#0D1F33" BorderBrush="#25425D" BorderThickness="0,0,0,1" Padding="26,0">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="47" Height="47" Background="#065D9C" BorderBrush="#38BCFF" BorderThickness="2" CornerRadius="6" Margin="0,0,18,0"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#46C3FF" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="A2Z System Inspector" FontSize="23" FontWeight="Bold" Foreground="#F5F9FF"/><TextBlock Text="Technical Diagnostic &amp; Health Check" FontSize="14" Foreground="#C1D4E6" Margin="0,3,0,0"/></StackPanel></StackPanel>
  <Border Grid.Column="1" Background="#0E342D" BorderBrush="#186F56" BorderThickness="1" CornerRadius="12" VerticalAlignment="Center" Padding="12,7"><TextBlock Text="●  TECHNICIAN EDITION" Foreground="#51E5A1" FontSize="11" FontWeight="SemiBold"/></Border>
 </Grid>
</Border>
<Border Grid.Row="1" Background="#091727" BorderBrush="#24415E" BorderThickness="0,0,0,1">
 <Grid HorizontalAlignment="Center" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="StepBadge1" Width="46" Height="46" CornerRadius="23" Background="#087FF7" Margin="0,0,13,0"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="White"/></Border><TextBlock x:Name="StepLabel1" Text="Job Details" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/></StackPanel>
  <TextBlock Grid.Column="1" Text="›" Foreground="#AFD5F3" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="StepBadge2" Width="46" Height="46" CornerRadius="23" Background="#10446F" Margin="0,0,13,0"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#CBE6FF"/></Border><TextBlock x:Name="StepLabel2" Text="Health Check" FontSize="17" FontWeight="Bold" Foreground="#A6BED6" VerticalAlignment="Center"/></StackPanel>
  <TextBlock Grid.Column="3" Text="›" Foreground="#AFD5F3" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="StepBadge3" Width="46" Height="46" CornerRadius="23" Background="#10446F" Margin="0,0,13,0"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#CBE6FF"/></Border><TextBlock x:Name="StepLabel3" Text="Results &amp; Export" FontSize="17" FontWeight="Bold" Foreground="#A6BED6" VerticalAlignment="Center"/></StackPanel>
 </Grid>
</Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<TabControl x:Name="Tabs" Grid.Column="1" Margin="0" Background="Transparent" BorderThickness="0" Style="{StaticResource FullPageTabs}" SelectionChanged="Tabs_SelectionChanged">
<TabItem Header="JOB DETAILS">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MaxWidth="960" HorizontalAlignment="Center" Margin="24,6,24,10">
   <TextBlock Text="Start a New Health Check" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#F0F7FF" Margin="0,0,0,9"/>
   <TextBlock Text="Enter minimal information to start a complete system inspection." HorizontalAlignment="Center" Foreground="#9FB8D1" FontSize="14" Margin="0,0,0,18"/>
   <Border CornerRadius="15" Background="#10253A" BorderBrush="#2A4B6C" BorderThickness="1" MaxWidth="740" HorizontalAlignment="Center" Padding="30,18,30,18">
    <StackPanel Width="625">
     <DockPanel Margin="0,0,0,18"><Border Width="48" Height="48" Background="#0758AC" CornerRadius="9" Margin="0,0,17,0"><TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="#46C0FF" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Job Details" FontSize="23" FontWeight="Bold" Foreground="#F5F9FF"/><TextBlock Text="Only two fields are needed to start." Foreground="#AFC4DB" Margin="0,5,0,0"/></StackPanel></DockPanel>
     <Border Background="#31516C" Height="1" Margin="0,0,0,17"/>
     <TextBlock Text="Job Number *" FontSize="15" FontWeight="SemiBold" Foreground="#F3F7FC" Margin="0,0,0,8"/>
     <TextBox x:Name="JobBox" Height="51" FontSize="18" Padding="15,10" VerticalContentAlignment="Center" Margin="0,0,0,22" ToolTip="Required job number from your ERP or work order."/>
     <TextBlock Text="Technician ID *" FontSize="15" FontWeight="SemiBold" Foreground="#F3F7FC" Margin="0,0,0,8"/>
     <TextBox x:Name="TechnicianBox" Height="51" FontSize="18" Padding="15,10" VerticalContentAlignment="Center" Margin="0,0,0,18" ToolTip="Required technician identifier."/>
     <TextBox x:Name="CustomerBox" Visibility="Collapsed" IsTabStop="False"/>
     <TextBox x:Name="ProblemBox" Visibility="Collapsed" IsTabStop="False"/>
     <Button x:Name="StartButton" Content="▶   START HEALTH CHECK" Click="Start_Click" Style="{StaticResource PrimaryButton}" Height="55" FontSize="17" HorizontalContentAlignment="Center" Margin="0" Padding="20,10"/>
     <Expander Header="ADVANCED INSPECTION OPTIONS" IsExpanded="False" Foreground="#A2BDD8" Margin="0,21,0,0">
      <StackPanel Margin="4,12,4,0"><TextBlock Text="Mode" Foreground="#AFC4DB" Margin="0,0,0,7"/><ComboBox x:Name="ModeBox" SelectedIndex="0" Width="240" HorizontalAlignment="Left"><ComboBoxItem Content="AUTOMATIC"/><ComboBoxItem Content="FULL"/><ComboBoxItem Content="MANUAL"/></ComboBox><TextBlock Text="Automatic uses safe decisions; manual and full modes are optional." Foreground="#87A8C9" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
     </Expander>
    </StackPanel>
   </Border>
   
  </StackPanel>
 </ScrollViewer>
</TabItem>
<TabItem Header="HEALTH CHECK">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="20,14,20,20" MaxWidth="1160" HorizontalAlignment="Center">
   <TextBlock Text="Running Health Check" FontWeight="Bold" FontSize="29" Foreground="#F2F8FF" HorizontalAlignment="Center"/>
   <TextBlock Text="Inspecting your system. Please wait..." Foreground="#A3BBD4" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,4"/>
   <TextBlock x:Name="InspectionIdText" Text="Preparing inspection session" Foreground="#6D99BC" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,18"/>
   <Border Background="#10253A" BorderBrush="#294C6D" BorderThickness="1" CornerRadius="16" Padding="26,24">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="220" Height="220" VerticalAlignment="Center" HorizontalAlignment="Center">
       <Ellipse Stroke="#3B5069" StrokeThickness="18" Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Path x:Name="ProgressArc" Width="220" Height="220" Stretch="None" Data="M 110,20 L 110,20" Stroke="#078BFF" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="ProgressPercentText" Text="0%" FontWeight="Bold" FontSize="43" Foreground="#F3F8FF" TextAlignment="Center"/><TextBlock Text="IN PROGRESS" Foreground="#D8E8F9" TextAlignment="Center" FontSize="12" Margin="0,5,0,0"/></StackPanel>
      </Grid>
      <StackPanel Grid.Column="1" Margin="18,0,0,0">
       <DockPanel Margin="0,1,0,14"><TextBlock Text="INSPECTION STAGES" FontWeight="SemiBold" FontSize="16" Foreground="#F0F7FF"/><TextBlock x:Name="OverallText" Text="RUNNING" HorizontalAlignment="Right" Foreground="#42D5A1" FontWeight="SemiBold"/></DockPanel>
       <ListView x:Name="ResultsList" Height="207" Background="#0B1C2F" BorderBrush="#274769" BorderThickness="1" Foreground="#EAF2FF" ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <ListView.View><GridView><GridViewColumn Header="CHECK" Width="157" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="STATUS" Width="95" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="DETAILS" Width="245" DisplayMemberBinding="{Binding Reason}"/></GridView></ListView.View>
       </ListView>
      </StackPanel>
     </Grid>
     <StackPanel Margin="0,20,0,0">
      <DockPanel><TextBlock x:Name="ElapsedText" Text="Elapsed: 00:00" Foreground="#D2E2F4" FontSize="14"/><TextBlock x:Name="EstimatedText" Text="Estimated remaining: calculating" HorizontalAlignment="Right" Foreground="#9EB9D3" FontSize="13"/></DockPanel>
      <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" Height="17" Foreground="#0C99FF" Background="#344B66" Margin="0,15,0,10"/>
      <TextBlock x:Name="ProgressText" Text="Ready to begin an inspection." Foreground="#C4D9EF" FontSize="13"/>
     </StackPanel>
     <Expander Header="LIVE EVIDENCE CONSOLE" Foreground="#77C3FF" Margin="0,16,0,0" IsExpanded="True">
      <TextBox x:Name="LiveConsoleBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="120" Margin="0,8,0,0" Background="#071727" Foreground="#C9E0F5"/>
     </Expander>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
      <Button x:Name="CancelInspectionButton" Content="■   CANCEL HEALTH CHECK" Style="{StaticResource DangerButton}" Click="CancelInspection_Click" IsEnabled="False" Width="250" Height="49" FontSize="14" HorizontalContentAlignment="Center"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</TabItem>
<TabItem Header="RESULTS &amp; EXPORT">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="20,12,20,26" MaxWidth="1200" HorizontalAlignment="Center">
   <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="✔  Inspection Complete" FontSize="29" FontWeight="Bold" Foreground="#F3F8FF"/><TextBlock Text="Review the health summary and export your inspection evidence." Foreground="#AEC5DE" FontSize="14" Margin="0,7,0,0"/></StackPanel>
    <Border Grid.Column="1" Background="#103C2F" BorderBrush="#1B9D60" BorderThickness="1" Padding="16,7" CornerRadius="10" VerticalAlignment="Center"><StackPanel><TextBlock Text="TOTAL TIME" Foreground="#B3EACE" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="TotalTimeText" Text="--:--" Foreground="#F4FFF9" FontWeight="Bold" FontSize="21" TextAlignment="Center"/></StackPanel></Border>
   </Grid>
   <Border x:Name="HealthSummaryBanner" Background="#132A43" BorderBrush="#418ED8" BorderThickness="2" CornerRadius="14" Padding="24,18" Margin="0,0,0,15">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border x:Name="HealthIconBadge" Width="60" Height="60" Background="#418ED8" CornerRadius="30" VerticalAlignment="Center" Margin="0,0,21,0"><TextBlock x:Name="HealthIconText" Text="i" FontSize="34" Foreground="#004328" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SYSTEM HEALTH" Foreground="#D4F7E4" FontWeight="Bold" FontSize="13"/><TextBlock x:Name="HealthStatusText" Text="NOT YET INSPECTED" FontWeight="Bold" Foreground="#E5FFF0" FontSize="30" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="HEALTH SCORE (IF AVAILABLE)" Foreground="#D4F7E4" HorizontalAlignment="Right" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="ScoreText" Text="N/A" FontSize="36" FontWeight="Bold" Foreground="#56FC9B"/><TextBlock Text=" / 100" FontSize="16" Foreground="#D6F7E7" VerticalAlignment="Bottom" Margin="5,0,0,5"/></StackPanel></StackPanel>
    </Grid>
   </Border>
   <Border Background="#10253A" BorderBrush="#2A4C6D" BorderThickness="1" CornerRadius="13" Padding="18,16" Margin="0,0,0,16">
    <StackPanel>
     <DockPanel Margin="0,0,0,13"><TextBlock Text="COMPONENT ASSESSMENT" FontSize="15" FontWeight="Bold" Foreground="#EAF4FE"/><TextBlock Text="Evidence-based results" HorizontalAlignment="Right" Foreground="#8AABC8" FontSize="12"/></DockPanel>
     <ListView x:Name="ResultsSummaryList" MaxHeight="280" MinHeight="150" Background="#0B1B2C" Foreground="#EAF4FE" BorderBrush="#284865" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.ItemTemplate><DataTemplate>
       <Border Padding="12,10" BorderBrush="#244563" BorderThickness="0,0,0,1">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◈" Foreground="#49B7FF" FontSize="16" Margin="0,0,11,0"/><TextBlock Text="{Binding Component}" FontWeight="SemiBold" FontSize="14" Foreground="#ECF4FF" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel>
         <Border x:Name="StatusPill" Grid.Column="1" Width="104" Background="#183B58" CornerRadius="13" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="7,4"><TextBlock x:Name="StatusPillText" Text="{Binding Status}" TextAlignment="Center" Foreground="#C9E4FB" FontWeight="SemiBold" FontSize="12"/></Border>
         <TextBlock Grid.Column="2" Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="#BFD3E6" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
       </Border>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="GOOD"><Setter TargetName="StatusPill" Property="Background" Value="#144F31"/><Setter TargetName="StatusPillText" Property="Foreground" Value="#9EFFC5"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="PASS"><Setter TargetName="StatusPill" Property="Background" Value="#144F31"/><Setter TargetName="StatusPillText" Property="Foreground" Value="#9EFFC5"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="ATTENTION"><Setter TargetName="StatusPill" Property="Background" Value="#694B12"/><Setter TargetName="StatusPillText" Property="Foreground" Value="#FFE28C"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="DEGRADED"><Setter TargetName="StatusPill" Property="Background" Value="#694B12"/><Setter TargetName="StatusPillText" Property="Foreground" Value="#FFE28C"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="CRITICAL"><Setter TargetName="StatusPill" Property="Background" Value="#702637"/><Setter TargetName="StatusPillText" Property="Foreground" Value="#FFB6C1"/></DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </StackPanel>
   </Border>
   <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,12">
    <Button Content="▤  VIEW REPORT" Click="ViewReport_Click" Width="185" Height="48" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
    <Button Content="⇩  EXPORT TO ERP" Click="ExportJson_Click" Style="{StaticResource PrimaryButton}" Width="200" Height="48" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
    <Button Content="⟳  RUN AGAIN" Click="New_Click" Width="175" Height="48" FontWeight="SemiBold" HorizontalContentAlignment="Center"/>
   </WrapPanel>
   <Expander x:Name="ReportDetails" Header="FULL TECHNICAL REPORT — CLICK TO EXPAND" IsExpanded="False" Foreground="#9DD0FC" Margin="0,5,0,10">
    <Border Background="#0B1A2C" BorderBrush="#2A4D70" BorderThickness="1" CornerRadius="9" Padding="8" Margin="0,7,0,0">
     <FlowDocumentScrollViewer x:Name="ReportViewer" Height="440" Background="#091A2D" Foreground="#EAF2FF" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" Zoom="100" MinZoom="50" MaxZoom="250" ZoomIncrement="10"/>
    </Border>
   </Expander>
   <Expander Header="ADVANCED TECHNICIAN TOOLS" IsExpanded="False" Foreground="#8FB0CF" Margin="0,4,0,0">
    <StackPanel Margin="0,8,0,0">
     <Expander Header="CPU stress-test graphs" IsExpanded="False" Foreground="#9AB8D2"><Grid Height="185" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Canvas x:Name="StressUtilizationGraph" Background="#071727" Margin="0,0,5,0"/><Canvas x:Name="StressThermalGraph" Grid.Column="1" Background="#071727" Margin="5,0,0,0"/></Grid></Expander>
     <WrapPanel Margin="0,12,0,4">
      <Button x:Name="RunStressButton" Content="CPU STAGED TEST" Style="{StaticResource PrimaryButton}" Click="Stress_Click"/>
      <Button x:Name="CancelStressButton" Content="STOP TEST" Style="{StaticResource DangerButton}" Click="CancelStress_Click" IsEnabled="False"/>
      <Button x:Name="SavePdfButton" Content="SAVE PDF (OPTIONAL)" Click="SavePdf_Click"/>
      <Button Content="EXPORT LOG" Click="ExportLog_Click"/>
      <Button Content="SAVE TEXT" Click="ExportText_Click"/>
     </WrapPanel>
    </StackPanel>
   </Expander>
  </StackPanel>
 </ScrollViewer>
</TabItem>
</TabControl></Grid>
<Border Grid.Row="3" Background="#071728" BorderBrush="#174268" BorderThickness="0,1,0,0" Padding="18,6"><DockPanel><StackPanel Orientation="Horizontal"><Ellipse Fill="{StaticResource Green}" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBlock x:Name="StatusText" Text="READY" Foreground="#B5C9DF"/></StackPanel><TextBlock Text="A2Z System Inspector  •  Windows x64" HorizontalAlignment="Right" Foreground="#6C88A7"/></DockPanel></Border>
</Grid></Window>
