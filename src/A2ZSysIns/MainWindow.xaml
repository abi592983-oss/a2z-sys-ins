<Window x:Class="A2ZSysIns.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A2Z System Inspector" Width="1180" Height="780" MinWidth="920" MinHeight="640" Background="#EDF3F8" Foreground="#102A43" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Border Padding="26,12"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#102A43" Offset="0"/><GradientStop Color="#1565C0" Offset="1"/></LinearGradientBrush></Border.Background><DockPanel><StackPanel><TextBlock Text="A2Z SYSTEM INSPECTOR" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="Evidence-based computer health screening" Foreground="#C7E0F4" FontSize="12"/></StackPanel><Border Background="#22FFFFFF" CornerRadius="14" Padding="13,6" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="READ ONLY • OFFLINE" Foreground="White" FontWeight="SemiBold"/></Border></DockPanel></Border>
    <TabControl x:Name="Tabs" Grid.Row="1" Margin="20" Background="White" BorderBrush="#D7E2EC" BorderThickness="1">
      <TabItem Header="1  Inspection details"><ScrollViewer><Grid Margin="28" MaxWidth="760" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="480"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="Start a new inspection" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock Grid.Row="1" Text="Customer / reference" VerticalAlignment="Center"/><TextBox x:Name="CustomerBox" Grid.Row="1" Grid.Column="1"/>
        <TextBlock Grid.Row="2" Text="Job number (optional)" VerticalAlignment="Center"/><TextBox x:Name="JobBox" Grid.Row="2" Grid.Column="1"/>
        <TextBlock Grid.Row="3" Text="Technician" VerticalAlignment="Center"/><TextBox x:Name="TechnicianBox" Grid.Row="3" Grid.Column="1"/>
        <TextBlock Grid.Row="4" Text="Reported problem" VerticalAlignment="Top" Margin="0,12,0,0"/><TextBox x:Name="ProblemBox" Grid.Row="4" Grid.Column="1" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="StartButton" Content="Start read-only inspection" Click="Start_Click"/><TextBlock Text="Some readings require administrator access." Foreground="DimGray" VerticalAlignment="Center" Margin="14,0"/></StackPanel>
      </Grid></ScrollViewer></TabItem>
      <TabItem Header="2  Progress"><StackPanel Margin="35" MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="Inspection in progress" FontSize="22" FontWeight="SemiBold"/><ProgressBar x:Name="Progress" Height="20" Margin="0,24,0,10" Minimum="0" Maximum="100"/><TextBlock x:Name="ProgressText" Text="Ready" FontSize="15"/><TextBlock Text="The application only reads diagnostic information. It does not repair, delete, clean, update, or modify this computer." TextWrapping="Wrap" Foreground="DimGray" Margin="0,30,0,0"/></StackPanel></TabItem>
      <TabItem Header="3  Results"><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#EAF4FF" BorderBrush="#B8D8F5" BorderThickness="1" CornerRadius="8" Padding="18"><DockPanel><TextBlock x:Name="OverallText" Text="No inspection completed" Foreground="#102A43" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="InspectionIdText" HorizontalAlignment="Right" Foreground="#486581" VerticalAlignment="Center"/></DockPanel></Border><ListView x:Name="ResultsList" Grid.Row="1" Margin="0,18" Background="White" Foreground="#243B53" BorderBrush="#D7E2EC"><ListView.View><GridView><GridViewColumn Header="Category" Width="190" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="Score" Width="100" DisplayMemberBinding="{Binding Score}"/><GridViewColumn Header="Status" Width="165" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Reason" Width="570" DisplayMemberBinding="{Binding Reason}"/></GridView></ListView.View></ListView><StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="View full report" Click="ViewReport_Click"/><Button Content="Export JSON evidence" Click="ExportJson_Click"/><Button Content="Save text summary" Click="ExportText_Click"/><Button Content="New inspection" Click="New_Click" Background="#526D82"/></StackPanel></Grid></TabItem>
      <TabItem Header="4  Report"><Grid Background="#E8EEF3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Margin="22" Background="White" BorderBrush="#CBD8E3" BorderThickness="1"><FlowDocumentScrollViewer x:Name="ReportViewer" Background="White" Foreground="#172B4D" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/></Border><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10"><Button Content="Print / Save as PDF" Click="Print_Click"/><Button Content="Export JSON evidence" Click="ExportJson_Click"/></StackPanel></Grid></TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#E6EEF6" Padding="18,8"><DockPanel><TextBlock x:Name="StatusText" Text="Ready"/><TextBlock Text="Version 1.0 • Windows 7 SP1 / 10 / 11 • Offline" HorizontalAlignment="Right" Foreground="DimGray"/></DockPanel></Border>
  </Grid>
</Window>
