<Window x:Class="A2ZSysIns.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A2Z System Inspector — Technician Console" Width="1080" Height="680" MinWidth="760" MinHeight="500" Background="#060909" Foreground="#D8FFE4" FontFamily="Consolas" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#0A1110"/><SolidColorBrush x:Key="Panel2" Color="#0D1715"/><SolidColorBrush x:Key="Green" Color="#58F58B"/><SolidColorBrush x:Key="DimGreen" Color="#8CBF9B"/><SolidColorBrush x:Key="Border" Color="#244834"/><SolidColorBrush x:Key="Amber" Color="#FFC857"/><SolidColorBrush x:Key="Red" Color="#FF6B6B"/>
    <Style TargetType="Button"><Setter Property="Background" Value="#10281B"/><Setter Property="Foreground" Value="{StaticResource Green}"/><Setter Property="BorderBrush" Value="#2F6B46"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#050807"/><Setter Property="Foreground" Value="#E8FFF0"/><Setter Property="BorderBrush" Value="#28523A"/><Setter Property="CaretBrush" Value="{StaticResource Green}"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#BDECCB"/><Setter Property="Background" Value="#0A1110"/><Setter Property="Padding" Value="12,7"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <Border Padding="18,9" Background="#050807" BorderBrush="#204B31" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel><TextBlock Text="A2Z // SYSTEM INSPECTOR" Foreground="{StaticResource Green}" FontSize="22" FontWeight="Bold"/><TextBlock Text="PROPRIETARY TECHNICIAN DIAGNOSTIC CONSOLE  •  READ-ONLY SCREENING" Foreground="#6FA982" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        <Border Background="#0D2116" BorderBrush="#2A6642" BorderThickness="1" CornerRadius="3" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="INTERNAL • A2Z ONLY" Foreground="#9BFFB8" FontSize="11" FontWeight="Bold"/></Border>
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="1" Margin="10" Background="#07100D" BorderBrush="#214431" BorderThickness="1">
      <TabItem Header="[01] SESSION">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid Margin="22" MaxWidth="800" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*" MinWidth="420"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.ColumnSpan="2" Text="> initialize inspection session" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Green}" Margin="0,0,0,18"/>
          <TextBlock Grid.Row="1" Text="customer/reference" Foreground="{StaticResource DimGreen}" VerticalAlignment="Center"/><TextBox x:Name="CustomerBox" Grid.Row="1" Grid.Column="1"/>
          <TextBlock Grid.Row="2" Text="job number (optional)" Foreground="{StaticResource DimGreen}" VerticalAlignment="Center"/><TextBox x:Name="JobBox" Grid.Row="2" Grid.Column="1"/>
          <TextBlock Grid.Row="3" Text="technician" Foreground="{StaticResource DimGreen}" VerticalAlignment="Center"/><TextBox x:Name="TechnicianBox" Grid.Row="3" Grid.Column="1"/>
          <TextBlock Grid.Row="4" Text="reported problem" Foreground="{StaticResource DimGreen}" VerticalAlignment="Top" Margin="0,12,0,0"/><TextBox x:Name="ProblemBox" Grid.Row="4" Grid.Column="1" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
          <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="StartButton" Content="RUN INSPECTION" Click="Start_Click"/><TextBlock Text="admin elevation may be required for privileged sensors" Foreground="#6F9A7C" VerticalAlignment="Center" Margin="14,0"/></StackPanel>
        </Grid></ScrollViewer>
      </TabItem>

      <TabItem Header="[02] LIVE CONSOLE">
        <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="> evidence acquisition" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Green}"/>
          <ProgressBar x:Name="Progress" Grid.Row="1" Height="16" Margin="0,14,0,12" Minimum="0" Maximum="100" Background="#07100D" Foreground="#53E984"/>
          <Border Grid.Row="2" Background="#020504" BorderBrush="#1E3E2C" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="[console]" Foreground="#5EF58C"/><TextBlock x:Name="ProgressText" Text="Ready" Foreground="#CFFFE0" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="No repair, cleanup, deletion, update or configuration change is performed by the automatic inspection." Foreground="#648A70" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border>
        </Grid>
      </TabItem>

      <TabItem Header="[03] EVIDENCE">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Background="#0B1712" BorderBrush="#28563A" BorderThickness="1" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OverallText" Text="No inspection completed" TextWrapping="Wrap" Foreground="{StaticResource Green}" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="InspectionIdText" Grid.Column="1" Margin="12,0,0,0" Foreground="#78A987" VerticalAlignment="Center"/></Grid></Border>
          <ListView x:Name="ResultsList" Grid.Row="1" Margin="0,10" Background="#040806" Foreground="#D5FBE0" BorderBrush="#20452F" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.View><GridView><GridViewColumn Header="EVIDENCE" Width="220" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="STATE" Width="175" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="INTERPRETATION / LIMITATION" Width="560" DisplayMemberBinding="{Binding Reason}"/></GridView></ListView.View></ListView>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel><Button x:Name="RunStressButton" Content="CPU STAGED TEST" Click="Stress_Click"/><Button x:Name="CancelStressButton" Content="STOP TEST" Click="CancelStress_Click" IsEnabled="False" Background="#3A1010" Foreground="#FF9696" BorderBrush="#7A2B2B"/><Button Content="OPEN REPORT" Click="ViewReport_Click"/><Button Content="EXPORT JSON" Click="ExportJson_Click"/><Button Content="EXPORT LOG" Click="ExportLog_Click"/><Button Content="SAVE TEXT" Click="ExportText_Click"/><Button Content="NEW SESSION" Click="New_Click"/></WrapPanel></ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="[04] REPORT">
        <Grid Background="#0A0F0D"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Margin="18" Background="White" BorderBrush="#28513A" BorderThickness="1"><FlowDocumentScrollViewer x:Name="ReportViewer" Background="White" Foreground="#172B4D" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/></Border><WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="8"><Button Content="PRINT / SAVE PDF" Click="Print_Click"/><Button Content="EXPORT JSON" Click="ExportJson_Click"/><Button Content="EXPORT LOG" Click="ExportLog_Click"/></WrapPanel></Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#040705" BorderBrush="#1C3B29" BorderThickness="0,1,0,0" Padding="12,6"><DockPanel><TextBlock x:Name="StatusText" Text="READY" Foreground="#79E697" TextTrimming="CharacterEllipsis"/><TextBlock Text="v2.4 • Windows 7 / 10 / 11" HorizontalAlignment="Right" Foreground="#5E8068"/></DockPanel></Border>
  </Grid>
</Window>
