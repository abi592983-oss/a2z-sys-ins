<Grid><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
<Border Background="#071728" BorderBrush="#174268" BorderThickness="0,0,0,1" Padding="20,0"><DockPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="A2Z" FontSize="28" FontWeight="Bold" Foreground="#2C93FF"/><Border Width="1" Height="25" Background="#31506F" Margin="16,0"/><TextBlock Text="A2Z System Inspector" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text=" — Technician Console" FontSize="17" Foreground="#B6CAE1" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Foreground="#C4D6EA" Margin="0,0,7,0"/><TextBlock Text="Settings" VerticalAlignment="Center" Foreground="#C4D6EA" Margin="0,0,22,0"/><TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="#C4D6EA" Margin="0,0,7,0"/><TextBlock Text="About" VerticalAlignment="Center" Foreground="#C4D6EA"/></StackPanel></DockPanel></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#071728" BorderBrush="#174268" BorderThickness="0,0,1,0"><Grid Margin="8,12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="WORKSPACE" Foreground="#6685A5" FontSize="11" FontWeight="SemiBold" Margin="12,8,12,10"/><Button Style="{StaticResource NavButton}" Click="Dashboard_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" Margin="0,0,13,0"/><TextBlock Text="Dashboard" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource NavButton}" Click="InspectionNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" Margin="0,0,13,0"/><TextBlock Text="Inspection" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource NavButton}" Click="ViewReport_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" Margin="0,0,13,0"/><TextBlock Text="Report" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource NavButton}" Click="InspectionNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE9F9;" Margin="0,0,13,0"/><TextBlock Text="Evidence &amp; Logs" VerticalAlignment="Center"/></StackPanel></Button></StackPanel><StackPanel Grid.Row="1" Margin="5,0"><Border Background="#0A2035" BorderBrush="#174268" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10"><StackPanel><TextBlock Text="INSPECTION MODE" Foreground="#7896B5" FontSize="10"/><ComboBox x:Name="ModeBox" SelectedIndex="0" Margin="0,7,0,0"><ComboBoxItem Content="AUTOMATIC"/><ComboBoxItem Content="FULL"/><ComboBoxItem Content="MANUAL"/></ComboBox></StackPanel></Border><Button x:Name="CancelInspectionButton" Content="CANCEL INSPECTION" Style="{StaticResource DangerButton}" Click="CancelInspection_Click" IsEnabled="False" Margin="0,0,0,4"/></StackPanel></Grid></Border>
<TabControl x:Name="Tabs" Grid.Column="1" Margin="16" Background="Transparent" BorderThickness="0">
