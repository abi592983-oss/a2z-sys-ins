icalAlignment="Center"/><TextBox x:Name="TechnicianBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/><TextBlock Grid.Row="4" Text="Reported problem" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,12,0,0"/><StackPanel Grid.Row="4" Grid.Column="1"><TextBox x:Name="ProblemBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4"/><Button x:Name="StartButton" Content="RUN INSPECTION" Style="{StaticResource PrimaryButton}" Click="Start_Click" HorizontalAlignment="Left" Padding="24,11" Margin="0,12,0,0"/></StackPanel></Grid></Border><UniformGrid Grid.Row="2" Columns="3"><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE7C3;" Foreground="#55A9FF"/><TextBlock Text="Evidence-led" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock Text="Capture findings with diagnostic context." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="5,0"><StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D2;" Foreground="{StaticResource Green}"/><TextBlock Text="Health checks" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock Text="System, storage, sensors and integrity." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="10,0,0,0"><StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" Foreground="#C297FF"/><TextBlock Text="Clear reporting" FontWeight="SemiBold" Margin="0,9,0,3"/><TextBlock Text="Export a polished technician report." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid></Grid></ScrollViewer></TabItem>
<TabItem Header="INSPECTION"><Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="16"><DockPanel><StackPanel><TextBlock Text="Inspection Overview" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="InspectionIdText" Text="Waiting for a new session" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="OUTCOME" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/><TextBlock x:Name="OverallText" Text="READY" Foreground="{StaticResource Green}" FontSize="16" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></DockPanel></Border><Border Grid.Row="1" Margin="0,12,12,12" Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Overall Progress" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="LIVE SESSION" Foreground="#51A5FF" FontSize="11" HorizontalAlignment="Right"/></DockPanel><ProgressBar x:Name="Progress" Height="10" Margin="0,14,0,8" Foreground="{StaticResource Green}" Background="#16324E"/><TextBlock x:Name="ProgressText" Text="Ready to begin an inspection." Foreground="#B2C7DF"/></StackPanel></Border><Border Grid.Row="2" Margin="0,0,12,0" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Inspection Stages &amp; Evidence" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0"/><ListView x:Name="ResultsList" Grid.Row="1" Background="#061525" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.View><GridView><GridViewColumn Header="STAGE / EVIDENCE" Width="210" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="STATE" Width="150" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="DETAILS" Width="460" DisplayMemberBinding="{Binding Reason}"/></GridView></ListView.View></ListView></Grid></Border><Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Live Console" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="● LIVE" Foreground="{StaticResource Green}" HorizontalAlignment="Right" FontSize="11"/></DockPanel><TextBox x:Name="LiveConsoleBox" Grid.Row="1" Margin="0,11" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/><StackPanel Grid.Row="2"><Button Content="VIEW REPORT" Style="{StaticResource PrimaryButton}" Click="ViewReport_Click" Margin="0,3"/><UniformGrid Columns="2"><Button Content="EXPORT JSON" Click="ExportJson_Click" Margin="0,3,3,3"/><Button Content="EXPORT LOG" Click="ExportLog_Click" Margin="3"/></UniformGrid></StackPanel></Grid></Border></Grid></TabItem>
<TabItem Header="REPORT"><Grid Margin="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,12"><DockPanel><StackPanel><TextBlock Text="Inspection Report" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Review measurements, findings, and evidence before export." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><TextBlock Text="REPORT CENTER" Foreground="#56A9FF" FontSize="11" VerticalAlignment="Center"/></DockPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Canvas x:Name="StressUtilizationGraph" Height="195" Background="#061525" Margin="3"/><Canvas x:Name="StressThermalGraph" Grid.Column="1" Height="195" Background="#061525" Margin="3"/></Grid></Border><Border Grid.Row="2" Margin="0,10" Style="{StaticResource Card}" Padding="0"><FlowDocumentScrollViewer x:Name="ReportViewer" Background="#091A2D" Foreground="#EAF2FF" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/></Border><WrapPanel Grid.Row="3" HorizontalAlignment="Right"><Button x:Name="RunStressButton" Content="CPU STAGED TEST" Style="{StaticResource PrimaryButton}" Click="Stress_Click"/><Button x:Name="CancelStressButton" Content="STOP TEST" Style="{StaticResource DangerButton}" Click="CancelStress_Click" IsEnabled="False"/><Button x:Name="SavePdfButton" Content="SAVE PDF" Style="{StaticResource PrimaryButton}" Click="SavePdf_Click"/><Button Content="EXPORT JSON" Click="ExportJson_Click"/><Button Content="EXPORT LOG" Click="ExportLog_Click"/><Button Content="SAVE TEXT" Click="ExportText_Click"/><Button Content="NEW SESSION" Click="New_Click"/></WrapPanel></Grid></TabItem>
</TabControl></Grid>
<Border Grid.Row="2" Background="#071728" BorderBrush="#174268" BorderThickness="0,1,0,0" Padding="18,6"><DockPanel><StackPanel Orientation="Horizontal"><Ellipse Fill="{StaticResource Green}" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBlock x:Name="StatusText" Text="READY" Foreground="#B5C9DF"/></StackPanel><TextBlock Text="A2Z System Inspector  •  Windows x64" HorizontalAlignment="Right" Foreground="#6C88A7"/></DockPanel></Border>
</Grid></Window>
