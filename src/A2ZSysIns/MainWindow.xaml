<Window x:Class="A2ZSysIns.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A2Z System Inspector — Technician Console" Width="1440" Height="900" MinWidth="1180" MinHeight="720" Background="#07111F" Foreground="#E8F0FA" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Window.Resources>
<SolidColorBrush x:Key="Panel" Color="#0B1728"/><SolidColorBrush x:Key="Panel2" Color="#0E1D31"/><SolidColorBrush x:Key="Line" Color="#233A58"/><SolidColorBrush x:Key="Blue" Color="#2693FF"/><SolidColorBrush x:Key="Green" Color="#43E78B"/><SolidColorBrush x:Key="Muted" Color="#8FA7C4"/>
<Style TargetType="Button"><Setter Property="Background" Value="#10243C"/><Setter Property="Foreground" Value="#E8F0FA"/><Setter Property="BorderBrush" Value="#2B4C70"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0878E8"/><Setter Property="BorderBrush" Value="#39A6FF"/></Style>
<Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#3A1520"/><Setter Property="BorderBrush" Value="#D84355"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#081321"/><Setter Property="Foreground" Value="#E8F0FA"/><Setter Property="BorderBrush" Value="#284564"/><Setter Property="Padding" Value="8"/></Style>
<Style TargetType="ComboBox"><Setter Property="Background" Value="#10243C"/><Setter Property="Foreground" Value="#E8F0FA"/><Setter Property="Padding" Value="7"/></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="#9EB4CE"/><Setter Property="Background" Value="#0B1728"/><Setter Property="Padding" Value="16,10"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="#12345A"/></Trigger></Style.Triggers></Style>
<Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#11243A"/><Setter Property="Foreground" Value="#AFC7E2"/><Setter Property="Padding" Value="8"/></Style>
</Window.Resources>
<Grid>
<Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
<Border Background="#081525" BorderBrush="#233A58" BorderThickness="0,0,0,1" Padding="20,0"><DockPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="A2Z" FontSize="25" FontWeight="Bold" Foreground="#49A7FF"/><TextBlock Text="  A2Z System Inspector — Technician Console" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="PRODUCTION MVP • TECHNICIAN" Foreground="#8FA7C4" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#081525" BorderBrush="#233A58" BorderThickness="0,0,1,0"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="WORKSPACE" Foreground="#7089A6" Margin="8,12"/><TextBlock Text="⌂  Dashboard" FontSize="15" Margin="8,10"/><TextBlock Text="⌕  Inspection" FontSize="15" Foreground="#49A7FF" Margin="8,10"/><TextBlock Text="▤  Evidence" FontSize="15" Margin="8,10"/><TextBlock Text="▥  Report" FontSize="15" Margin="8,10"/><TextBlock Text="≡  Logs" FontSize="15" Margin="8,10"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="Inspection Mode" Foreground="#8FA7C4" Margin="4"/><ComboBox x:Name="ModeBox" SelectedIndex="0" Margin="4"><ComboBoxItem Content="AUTOMATIC"/><ComboBoxItem Content="FULL"/><ComboBoxItem Content="MANUAL"/></ComboBox><Button x:Name="CancelInspectionButton" Content="CANCEL INSPECTION" Style="{StaticResource DangerButton}" Click="CancelInspection_Click" IsEnabled="False" Margin="4,14,4,4"/></StackPanel></Grid></Border>
<TabControl x:Name="Tabs" Grid.Column="1" Margin="14" Background="#07111F" BorderThickness="0">
<TabItem Header="START"><ScrollViewer><Grid Margin="18" MaxWidth="900" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.ColumnSpan="2" Text="Start a new system inspection" FontSize="25" FontWeight="Bold" Margin="0,0,0,22"/><TextBlock Grid.Row="1" Text="Customer / reference" Foreground="#8FA7C4" VerticalAlignment="Center"/><TextBox x:Name="CustomerBox" Grid.Row="1" Grid.Column="1" Margin="0,5"/><TextBlock Grid.Row="2" Text="Job number" Foreground="#8FA7C4" VerticalAlignment="Center"/><TextBox x:Name="JobBox" Grid.Row="2" Grid.Column="1" Margin="0,5"/><TextBlock Grid.Row="3" Text="Technician" Foreground="#8FA7C4" VerticalAlignment="Center"/><TextBox x:Name="TechnicianBox" Grid.Row="3" Grid.Column="1" Margin="0,5"/><TextBlock Grid.Row="4" Text="Reported problem" Foreground="#8FA7C4" VerticalAlignment="Top" Margin="0,12,0,0"/><TextBox x:Name="ProblemBox" Grid.Row="4" Grid.Column="1" Height="110" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5"/><Button x:Name="StartButton" Grid.Row="5" Grid.Column="1" Content="RUN INSPECTION" Style="{StaticResource PrimaryButton}" Click="Start_Click" HorizontalAlignment="Left" Padding="28,12" Margin="0,18,0,0"/></Grid></ScrollViewer></TabItem>
<TabItem Header="INSPECTION"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.ColumnSpan="2" Background="#0B1728" BorderBrush="#233A58" BorderThickness="1" CornerRadius="8" Padding="16"><DockPanel><StackPanel><TextBlock Text="System Inspection" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="InspectionIdText" Text="Waiting for session" Foreground="#8FA7C4" Margin="0,4,0,0"/></StackPanel><TextBlock x:Name="OverallText" Text="READY" Foreground="#43E78B" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
<Border Grid.Row="1" Margin="0,10,10,10" Background="#0B1728" BorderBrush="#233A58" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="Overall Progress" FontWeight="SemiBold"/><ProgressBar x:Name="Progress" Height="9" Margin="0,12,0,8" Foreground="#43E78B" Background="#172B45"/><TextBlock x:Name="ProgressText" Text="Ready" Foreground="#AFC7E2"/></StackPanel></Border>
<Border Grid.Row="2" Margin="0,0,10,0" Background="#0B1728" BorderBrush="#233A58" BorderThickness="1" CornerRadius="8" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Inspection Stages / Evidence" FontSize="16" FontWeight="SemiBold" Margin="4,2,4,10"/><ListView x:Name="ResultsList" Grid.Row="1" Background="#081321" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.View><GridView><GridViewColumn Header="STAGE / EVIDENCE" Width="210" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="STATE" Width="150" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="DETAILS" Width="460" DisplayMemberBinding="{Binding Reason}"/></GridView></ListView.View></ListView></Grid></Border>
<Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Margin="0,10,0,0" Background="#0B1728" BorderBrush="#233A58" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Live Console" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="LIVE" Foreground="#43E78B" HorizontalAlignment="Right"/></DockPanel><TextBox x:Name="LiveConsoleBox" Grid.Row="1" Margin="0,10" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/><WrapPanel Grid.Row="2"><Button Content="EXPORT JSON" Click="ExportJson_Click"/><Button Content="EXPORT LOG" Click="ExportLog_Click"/><Button Content="OPEN REPORT" Click="ViewReport_Click"/></WrapPanel></Grid></Border>
</Grid></TabItem>
<TabItem Header="REPORT"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#0B1728" BorderBrush="#233A58" BorderThickness="1" CornerRadius="8" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Canvas x:Name="StressUtilizationGraph" Height="195" Background="#06101B" Margin="3"/><Canvas x:Name="StressThermalGraph" Grid.Column="1" Height="195" Background="#06101B" Margin="3"/></Grid></Border><Border Grid.Row="1" Margin="0,8" Background="#0B1728" BorderBrush="#233A58" BorderThickness="1" CornerRadius="8"><FlowDocumentScrollViewer x:Name="ReportViewer" Background="#0B1728" Foreground="#E8F0FA" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/></Border><WrapPanel Grid.Row="2" HorizontalAlignment="Center"><Button x:Name="RunStressButton" Content="CPU STAGED TEST" Style="{StaticResource PrimaryButton}" Click="Stress_Click"/><Button x:Name="CancelStressButton" Content="STOP TEST" Style="{StaticResource DangerButton}" Click="CancelStress_Click" IsEnabled="False"/><Button x:Name="SavePdfButton" Content="SAVE PDF" Style="{StaticResource PrimaryButton}" Click="SavePdf_Click"/><Button Content="EXPORT JSON" Click="ExportJson_Click"/><Button Content="EXPORT LOG" Click="ExportLog_Click"/><Button Content="SAVE TEXT" Click="ExportText_Click"/><Button Content="NEW SESSION" Click="New_Click"/></WrapPanel></Grid></TabItem>
</TabControl></Grid>
<Border Grid.Row="2" Background="#081525" BorderBrush="#233A58" BorderThickness="0,1,0,0" Padding="14,7"><DockPanel><TextBlock x:Name="StatusText" Text="READY" Foreground="#43E78B"/><TextBlock Text="A2Z System Inspector • Windows x64" HorizontalAlignment="Right" Foreground="#7089A6"/></DockPanel></Border>
</Grid></Window>