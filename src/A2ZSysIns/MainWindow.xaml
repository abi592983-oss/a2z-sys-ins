<Window x:Class="A2ZSysIns.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A2Z System Inspector — Technician Console" Width="1440" Height="900" MinWidth="1180" MinHeight="720" Background="#06111F" Foreground="#EAF2FF" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
