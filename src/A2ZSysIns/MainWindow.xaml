<Window x:Class="A2ZSysIns.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A2Z Sys Inspector" Width="1180" Height="760" MinWidth="980" MinHeight="650" Background="#071018" Foreground="#E8F1F5" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#071018"/><SolidColorBrush x:Key="Panel" Color="#0D1A24"/><SolidColorBrush x:Key="Border" Color="#1E3442"/><SolidColorBrush x:Key="Text" Color="#E8F1F5"/><SolidColorBrush x:Key="Muted" Color="#8296A4"/><SolidColorBrush x:Key="Green" Color="#20E58A"/><SolidColorBrush x:Key="Blue" Color="#1EA7FF"/><SolidColorBrush x:Key="Amber" Color="#FFB51B"/><SolidColorBrush x:Key="Red" Color="#FF5B62"/>
    <Style TargetType="Button"><Setter Property="Background" Value="#10212D"/><Setter Property="Foreground" Value="#DDEAF0"/><Setter Property="BorderBrush" Value="#254152"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="3"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#173044"/><Setter TargetName="B" Property="BorderBrush" Value="#1EA7FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#0B1720"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#087B4C"/><Setter Property="Foreground" Value="#F0FFF8"/><Setter Property="BorderBrush" Value="#20E58A"/><Setter Property="Padding" Value="18,10"/></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#32171A"/><Setter Property="Foreground" Value="#FFB1B5"/><Setter Property="BorderBrush" Value="#733237"/></Style>
    <Style x:Key="NavTab" TargetType="TabItem"><Setter Property="Foreground" Value="#8DA2B0"/><Setter Property="Background" Value="#09141D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,2,8,2"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#12334A"/><Setter Property="Foreground" Value="#E8F7FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#10232F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#0D1A24"/><Setter Property="BorderBrush" Value="#1E3442"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="4"/></Style>
    <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#8DA2B0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="BigValue" TargetType="TextBlock"><Setter Property="Foreground" Value="#E8F1F5"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#09141D"/><Setter Property="Foreground" Value="#E8F1F5"/><Setter Property="BorderBrush" Value="#1E3442"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,3"/><Setter Property="FontSize" Value="12"/></Style>
  </Window.Resources>
  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#09141D" BorderBrush="#1E3442" BorderThickness="0,0,0,1" Padding="20,10"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="38" Height="38" CornerRadius="10" Background="#0B6E48" Margin="0,0,12,0"><TextBlock Text="A2" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="A2Z Sys Inspector" FontSize="20" FontWeight="Bold"/><TextBlock Text="Diagnostics today. A healthier tomorrow." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="↻  Scan Again" Click="Start_Click"/><Button Content="⇩  Export Report" Click="ViewReport_Click"/><Button Content="⚙  Settings" IsEnabled="False"/><TextBlock Text="—  □  ×" Foreground="#718592" FontSize="15" VerticalAlignment="Center" Margin="18,0,2,0"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1" Margin="10,10,10,8"><Grid.ColumnDefinitions><ColumnDefinition Width="178"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#09141D" BorderBrush="#1E3442" BorderThickness="1" CornerRadius="12" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="5,0,5,4"><TextBlock Text="A2Z SYS INSPECTOR" Foreground="#617785" FontSize="9" FontWeight="Bold"/><TextBlock Text="Windows 7 / 10 / 11  •  x64" Foreground="#6D8290" FontSize="9" Margin="0,3,0,0"/></StackPanel><TabControl x:Name="Tabs" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><TabControl.Resources><Style TargetType="TabPanel"><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0"/></Style></TabControl.Resources>
        <TabItem Header="⌂   DASHBOARD" Style="{StaticResource NavTab}"><ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><Grid Margin="4,0,6,0"><Grid.RowDefinitions><RowDefinition Height="175"/><RowDefinition Height="126"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#0A151D" CornerRadius="10" Margin="0,0,18,0"><TextBlock Text="PC" FontSize="54" FontWeight="Bold" Foreground="#244457" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="DEVICE" Style="{StaticResource CardTitle}"/><TextBlock x:Name="DeviceNameText" Text="Ready for inspection" FontSize="24" FontWeight="Bold" Margin="0,4,0,4" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DeviceDetailsText" Text="Run an inspection to identify the system, hardware and Windows condition." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/><Button Content="View System Details →" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ViewReport_Click"/></StackPanel></Grid></Border>
          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Stroke="#203442" StrokeThickness="13"/><Ellipse Stroke="{StaticResource Green}" StrokeThickness="13" StrokeDashArray="7 3" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse><StackPanel VerticalAlignment="Center"><TextBlock x:Name="OverallScoreText" Text="—" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="/ 100" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="SYSTEM HEALTH SCORE" Style="{StaticResource CardTitle}"/><TextBlock x:Name="OverallStatusBadge" Text="NOT TESTED" Foreground="{StaticResource Muted}" FontSize="15" FontWeight="Bold" Margin="0,6,0,5"/><TextBlock x:Name="OverallHeadlineText" Text="No inspection completed" Foreground="{StaticResource Text}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="See recommendations below." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0"/></StackPanel></Grid></Border>
          <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="6"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU" Style="{StaticResource CardTitle}"/><TextBlock x:Name="CpuValueText" Text="—" Style="{StaticResource BigValue}"/><TextBlock x:Name="CpuStatusText" Text="Not tested" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MEMORY" Style="{StaticResource CardTitle}"/><TextBlock x:Name="MemoryValueText" Text="—" Style="{StaticResource BigValue}"/><TextBlock x:Name="MemoryStatusText" Text="Not tested" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="STORAGE" Style="{StaticResource CardTitle}"/><TextBlock x:Name="StorageValueText" Text="—" Style="{StaticResource BigValue}"/><TextBlock x:Name="StorageStatusText" Text="Not tested" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TEMPERATURE" Style="{StaticResource CardTitle}"/><TextBlock x:Name="TemperatureValueText" Text="—" Style="{StaticResource BigValue}"/><TextBlock x:Name="TemperatureStatusText" Text="Not tested" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WINDOWS" Style="{StaticResource CardTitle}"/><TextBlock x:Name="WindowsValueText" Text="—" Style="{StaticResource BigValue}"/><TextBlock x:Name="WindowsStatusText" Text="Not tested" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DEVICES" Style="{StaticResource CardTitle}"/><TextBlock x:Name="DevicesValueText" Text="—" Style="{StaticResource BigValue}"/><TextBlock x:Name="DevicesStatusText" Text="Not tested" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border></UniformGrid>
          <Grid Grid.Row="2" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU TEMPERATURE &amp; LOAD" FontSize="13" FontWeight="Bold"/><TextBlock Text="Actual telemetry from the inspection session" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,8"/><Border Background="#081219" CornerRadius="8" Padding="5"><Canvas x:Name="DashboardStressGraph" Height="132"/></Border></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="RECENT EVENTS" FontSize="13" FontWeight="Bold"/><TextBlock Text="View all →" HorizontalAlignment="Right" Foreground="{StaticResource Blue}" FontSize="10"/></Grid><ListView x:Name="RecentEventsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" Height="145"><ListView.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="●" Foreground="{StaticResource Green}"/><TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="10" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border></Grid>
          <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#0B2940" BorderBrush="#174B69" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,6,4,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="i" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Blue}" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="RECOMMENDED NEXT STEPS" Foreground="#62C7FF" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="RecommendationText" Text="Complete an inspection to receive evidence-based recommendations." Foreground="#D9EDF7" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="VIEW FULL REPORT →" Style="{StaticResource PrimaryButton}" Click="ViewReport_Click"/></Grid></Border>
        </Grid></ScrollViewer></TabItem>
        <TabItem Header="▣   LIVE SCAN" Style="{StaticResource NavTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Inspection setup" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/><Border Style="{StaticResource Card}" Grid.Row="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="CUSTOMER" Style="{StaticResource CardTitle}"/><TextBox x:Name="CustomerBox"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="JOB NUMBER" Style="{StaticResource CardTitle}"/><TextBox x:Name="JobBox"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="TECHNICIAN" Style="{StaticResource CardTitle}"/><TextBox x:Name="TechnicianBox"/></StackPanel><StackPanel Grid.Column="3" Margin="8,0"><TextBlock Text="REPORTED PROBLEM" Style="{StaticResource CardTitle}"/><TextBox x:Name="ProblemBox"/></StackPanel></Grid></Border><Border Style="{StaticResource Card}" Grid.Row="2"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Evidence acquisition" FontSize="16" FontWeight="Bold"/><ProgressBar x:Name="Progress" Grid.Row="1" Height="8" Margin="0,12,0,0" Background="#14232D" Foreground="{StaticResource Green}" BorderThickness="0"/></Grid></Border><Border Grid.Row="3" Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="CURRENT STEP" Style="{StaticResource CardTitle}"/><TextBlock x:Name="ProgressText" Text="Ready" FontSize="17" Margin="0,8,0,0"/><TextBlock Text="The Inspector is read-only. It acquires evidence, retries through alternate providers and records provenance without repairing or modifying the computer." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/><Button x:Name="StartButton" Content="RUN INSPECTION" Style="{StaticResource PrimaryButton}" Click="Start_Click" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border></Grid></ScrollViewer></TabItem>
        <TabItem Header="▤   EVIDENCE" Style="{StaticResource NavTab}"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#10212D" BorderBrush="#1E3442" BorderThickness="1" CornerRadius="10" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OverallText" Text="No inspection completed" Foreground="{StaticResource Green}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="InspectionIdText" Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></Border><ListView x:Name="ResultsList" Grid.Row="1" Margin="0,10" Background="#09141D" Foreground="#D8E6EC" BorderBrush="#1E3442"><ListView.View><GridView><GridViewColumn Header="EVIDENCE" Width="200" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="STATE" Width="145" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="INTERPRETATION" Width="570" DisplayMemberBinding="{Binding Reason}"/></GridView></ListView.View></ListView><WrapPanel Grid.Row="2"><Button x:Name="RunStressButton" Content="CPU STAGED TEST" Style="{StaticResource PrimaryButton}" Click="Stress_Click"/><Button x:Name="CancelStressButton" Content="STOP TEST" Style="{StaticResource DangerButton}" Click="CancelStress_Click" IsEnabled="False"/><Button Content="OPEN REPORT" Click="ViewReport_Click"/><Button Content="EXPORT JSON" Click="ExportJson_Click"/><Button Content="EXPORT LOG" Click="ExportLog_Click"/><Button Content="SAVE TEXT" Click="ExportText_Click"/><Button Content="NEW SESSION" Click="New_Click"/></WrapPanel></Grid></TabItem>
        <TabItem Header="▥   REPORT" Style="{StaticResource NavTab}"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="255"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#071018" BorderBrush="#1E3442" BorderThickness="1" CornerRadius="10" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="LIVE CPU STRESS TELEMETRY  •  ACTUAL SAMPLES ONLY" Foreground="{StaticResource Green}" FontWeight="Bold" Margin="4,2,4,6"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Canvas x:Name="StressUtilizationGraph" Grid.Column="0" Height="205" Background="#02070A" Margin="2"/><Canvas x:Name="StressThermalGraph" Grid.Column="1" Height="205" Background="#02070A" Margin="2"/></Grid></Grid></Border><Border Grid.Row="1" Margin="4,8,4,4" Background="#09141D" BorderBrush="#1E3442" BorderThickness="1" CornerRadius="10"><FlowDocumentScrollViewer x:Name="ReportViewer" Background="#09141D" Foreground="#D5E3D8" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/></Border><WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="8"><Button x:Name="SavePdfButton" Content="SAVE PDF" Style="{StaticResource PrimaryButton}" Click="SavePdf_Click"/><Button Content="EXPORT JSON" Click="ExportJson_Click"/><Button Content="EXPORT LOG" Click="ExportLog_Click"/></WrapPanel></Grid></TabItem>
      </TabControl></DockPanel></Border>
    </Grid>
    <Border Grid.Row="2" Background="#09141D" BorderBrush="#1E3442" BorderThickness="0,1,0,0" Padding="14,5"><DockPanel><TextBlock x:Name="StatusText" Text="READY" Foreground="{StaticResource Green}" FontSize="10"/><TextBlock Text="A2Z Sys Inspector  •  Windows diagnostic screening" HorizontalAlignment="Right" Foreground="#657A87" FontSize="9"/></DockPanel></Border>
  </Grid>
</Window>