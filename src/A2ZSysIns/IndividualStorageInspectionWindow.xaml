<Window x:Class="A2ZSysIns.IndividualStorageInspectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A2Z System Inspector — Storage Inspector" Width="900" Height="620" MinWidth="700" MinHeight="480" Background="#000000" Foreground="#D7E8DC" FontFamily="Consolas" WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="> individual storage inspection" FontSize="20" FontWeight="Bold" Foreground="#00FF41"/>
    <DockPanel Grid.Row="1" Margin="0,14,0,10">
      <ComboBox x:Name="DriveSelector" Width="520" Height="32" Background="#000000" Foreground="#00FF41" BorderBrush="#174B25" SelectionChanged="DriveSelector_SelectionChanged"/>
      <Button x:Name="InspectButton" Content="INSPECT SELECTED DRIVE" Click="InspectButton_Click" Margin="10,0,0,0"/>
    </DockPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#000000">
      <StackPanel>
        <Border BorderBrush="#12351D" BorderThickness="1" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock x:Name="DeviceText" Text="No drive selected" Foreground="#00FF41" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="IdentityText" Foreground="#79D98E" Margin="0,7,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="HealthText" Foreground="#D5E3D8" Margin="0,10,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="#12351D" BorderThickness="1" Padding="12" Margin="0,0,5,0"><StackPanel><TextBlock Text="ENDURANCE / LIFE" Foreground="#00FF41" FontWeight="Bold"/><TextBlock x:Name="EnduranceText" Foreground="#D5E3D8" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Grid.Column="1" BorderBrush="#12351D" BorderThickness="1" Padding="12" Margin="5,0,0,0"><StackPanel><TextBlock Text="TEMPERATURE" Foreground="#00FF41" FontWeight="Bold"/><TextBlock x:Name="TemperatureText" Foreground="#D5E3D8" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </Grid>
        <Border BorderBrush="#12351D" BorderThickness="1" Padding="12">
          <StackPanel>
            <TextBlock Text="EVIDENCE LIMITATIONS" Foreground="#00FF41" FontWeight="Bold"/>
            <TextBlock x:Name="LimitationsText" Foreground="#D5E3D8" Margin="0,8,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Temperature graph: not shown unless multiple real timestamped samples exist. A single current reading is not converted into invented history." Foreground="#467D53" Margin="0,14,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
