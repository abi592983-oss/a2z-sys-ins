<Window x:Class="A2ZSysIns.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A2Z System Inspector — Technician Console" Width="1080" Height="680" MinWidth="760" MinHeight="500" Background="#080A09" Foreground="#E5EEE7" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Green" Color="#35E875"/><SolidColorBrush x:Key="DimGreen" Color="#75A987"/><SolidColorBrush x:Key="Text" Color="#E5EEE7"/><SolidColorBrush x:Key="Muted" Color="#8FA696"/>
    <Style TargetType="Button"><Setter Property="Background" Value="#151C17"/><Setter Property="Foreground" Value="#DDEBE1"/><Setter Property="BorderBrush" Value="#304638"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#1C2A20"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#35E875"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#0D130F"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#75FF9F"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#174F2D"/><Setter Property="Foreground" Value="#E9FFF0"/><Setter Property="BorderBrush" Value="#35E875"/><Setter Property="Padding" Value="20,10"/></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#241313"/><Setter Property="Foreground" Value="#FF9A9A"/><Setter Property="BorderBrush" Value="#6B3030"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0C100D"/><Setter Property="Foreground" Value="#E5EEE7"/><Setter Property="BorderBrush" Value="#2B4032"/><Setter Property="CaretBrush" Value="#35E875"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,5"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#141A16"/><Setter Property="Foreground" Value="#75E89A"/><Setter Property="BorderBrush" Value="#26382C"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="ListViewItem"><Setter Property="Background" Value="#0C100D"/><Setter Property="Foreground" Value="#D8E5DB"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="#1C2920" BorderThickness="0,0,0,1" Padding="3"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#142119"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2E8F50"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#193A25"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#35E875"/><Setter Property="Foreground" Value="#F0FFF4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#8FA696"/><Setter Property="Background" Value="#0C100D"/><Setter Property="BorderBrush" Value="#26382C"/><Setter Property="Padding" Value="15,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}" Margin="2,2,2,0"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#17271C"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#35E875"/><Setter Property="Foreground" Value="#35E875"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#111A14"/><Setter Property="Foreground" Value="#C8EAD2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Background="#080A09"><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
    <Border Padding="22,11" Background="#0B0F0C" BorderBrush="#26382C" BorderThickness="0,0,0,1"><DockPanel><StackPanel><TextBlock Text="A2Z  /  SYSTEM INSPECTOR" Foreground="{StaticResource Green}" FontSize="21" FontWeight="Bold"/><TextBlock Text="TECHNICIAN DIAGNOSTIC CONSOLE  •  READ-ONLY AUTOMATED SCREENING" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel><Border Background="#122219" BorderBrush="#2C6D42" BorderThickness="1" CornerRadius="12" Padding="11,5" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="INTERNAL • A2Z ONLY" Foreground="#8FF3AD" FontSize="11" FontWeight="Bold"/></Border></DockPanel></Border>
    <TabControl x:Name="Tabs" Grid.Row="1" Margin="12" Background="#080A09" BorderBrush="#26382C" BorderThickness="1">
      <TabItem Header="SESSION"><ScrollViewer Background="#080A09" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid Margin="24" MaxWidth="820" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*" MinWidth="440"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.ColumnSpan="2" Text="Start inspection" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Green}" Margin="0,0,0,20"/><TextBlock Grid.Row="1" Text="Customer / reference" Foreground="{StaticResource DimGreen}" VerticalAlignment="Center"/><TextBox x:Name="CustomerBox" Grid.Row="1" Grid.Column="1"/><TextBlock Grid.Row="2" Text="Job number" Foreground="{StaticResource DimGreen}" VerticalAlignment="Center"/><TextBox x:Name="JobBox" Grid.Row="2" Grid.Column="1"/><TextBlock Grid.Row="3" Text="Technician" Foreground="{StaticResource DimGreen}" VerticalAlignment="Center"/><TextBox x:Name="TechnicianBox" Grid.Row="3" Grid.Column="1"/><TextBlock Grid.Row="4" Text="Reported problem" Foreground="{StaticResource DimGreen}" VerticalAlignment="Top" Margin="0,13,0,0"/><TextBox x:Name="ProblemBox" Grid.Row="4" Grid.Column="1" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/><StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="StartButton" Content="RUN INSPECTION" Style="{StaticResource PrimaryButton}" Click="Start_Click"/><TextBlock Text="All physical storage devices are detected and scanned automatically. CPU stress testing is technician-controlled." Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0" TextWrapping="Wrap"/></StackPanel></Grid></ScrollViewer></TabItem>
      <TabItem Header="LIVE CONSOLE"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Evidence acquisition" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Green}"/><ProgressBar x:Name="Progress" Grid.Row="1" Height="8" Margin="0,16,0,14" Background="#151B17" Foreground="#35E875" BorderThickness="0"/><Border Grid.Row="2" Background="#0C100D" BorderBrush="#26382C" BorderThickness="1" CornerRadius="9" Padding="18"><StackPanel><TextBlock Text="CURRENT STEP" Foreground="{StaticResource DimGreen}" FontWeight="SemiBold"/><TextBlock x:Name="ProgressText" Text="Ready" Foreground="{StaticResource Text}" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="No repair, cleanup, deletion, update or configuration change is performed by the automatic inspection." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border></Grid></TabItem>
      <TabItem Header="EVIDENCE"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#101711" BorderBrush="#2C6D42" BorderThickness="1" CornerRadius="9" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OverallText" Text="No inspection completed" TextWrapping="Wrap" Foreground="{StaticResource Green}" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="InspectionIdText" Grid.Column="1" Margin="12,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></Border><ListView x:Name="ResultsList" Grid.Row="1" Margin="0,12" Background="#0C100D" Foreground="#D8E5DB" BorderBrush="#26382C" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.View><GridView><GridViewColumn Header="EVIDENCE" Width="220" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="STATE" Width="175" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="INTERPRETATION / LIMITATION" Width="560" DisplayMemberBinding="{Binding Reason}"/></GridView></ListView.View></ListView><ScrollViewer Grid.Row="2" Background="#080A09" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel><Button x:Name="RunStressButton" Content="CPU STAGED TEST" Style="{StaticResource PrimaryButton}" Click="Stress_Click"/><Button x:Name="CancelStressButton" Content="STOP TEST" Style="{StaticResource DangerButton}" Click="CancelStress_Click" IsEnabled="False"/><Button Content="OPEN REPORT" Click="ViewReport_Click"/><Button Content="EXPORT JSON" Click="ExportJson_Click"/><Button Content="EXPORT LOG" Click="ExportLog_Click"/><Button Content="SAVE TEXT" Click="ExportText_Click"/><Button Content="NEW SESSION" Click="New_Click"/></WrapPanel></ScrollViewer></Grid></TabItem>
      <TabItem Header="REPORT"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="255"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#080A09" BorderBrush="#26382C" BorderThickness="1" CornerRadius="9" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="LIVE CPU STRESS TELEMETRY  •  ACTUAL SAMPLES ONLY" Foreground="{StaticResource Green}" FontWeight="Bold" Margin="4,2,4,6"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Canvas x:Name="StressUtilizationGraph" Grid.Column="0" Height="205" Background="#020402" Margin="2"/><Canvas x:Name="StressThermalGraph" Grid.Column="1" Height="205" Background="#020402" Margin="2"/></Grid></Grid></Border><Border Grid.Row="1" Margin="4,8,4,4" Background="#0C100D" BorderBrush="#26382C" BorderThickness="1" CornerRadius="9"><FlowDocumentScrollViewer x:Name="ReportViewer" Background="#0C100D" Foreground="#D5E3D8" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/></Border><WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="8"><Button x:Name="SavePdfButton" Content="SAVE PDF" Style="{StaticResource PrimaryButton}" Click="SavePdf_Click"/><Button Content="EXPORT JSON" Click="ExportJson_Click"/><Button Content="EXPORT LOG" Click="ExportLog_Click"/></WrapPanel></Grid></TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#0B0F0C" BorderBrush="#26382C" BorderThickness="0,1,0,0" Padding="14,7"><DockPanel><TextBlock x:Name="StatusText" Text="READY" Foreground="{StaticResource Green}" TextTrimming="CharacterEllipsis"/><TextBlock Text="v2.4  •  Windows 7 / 10 / 11" HorizontalAlignment="Right" Foreground="#6F8878"/></DockPanel></Border>
  </Grid>
</Window>