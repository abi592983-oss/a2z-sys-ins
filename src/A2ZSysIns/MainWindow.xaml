<Window x:Class="A2ZSysIns.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A2Z System Inspector — Technician Console" Width="1080" Height="680" MinWidth="760" MinHeight="500" Background="#000000" Foreground="#D7E8DC" FontFamily="Consolas" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- Sharp terminal green: intentionally bright and flat, not pastel/glowing. -->
    <SolidColorBrush x:Key="Panel" Color="#020302"/>
    <SolidColorBrush x:Key="Panel2" Color="#030504"/>
    <SolidColorBrush x:Key="Green" Color="#00FF41"/>
    <SolidColorBrush x:Key="DimGreen" Color="#39A85A"/>
    <SolidColorBrush x:Key="Border" Color="#12351D"/>
    <SolidColorBrush x:Key="Amber" Color="#FFB000"/>
    <SolidColorBrush x:Key="Red" Color="#FF4040"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#050A06"/>
      <Setter Property="Foreground" Value="#00FF41"/>
      <Setter Property="BorderBrush" Value="#1B5C2B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#000000"/>
      <Setter Property="Foreground" Value="#E0FFE8"/>
      <Setter Property="BorderBrush" Value="#174B25"/>
      <Setter Property="CaretBrush" Value="#00FF41"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,5"/>
    </Style>

    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="#030603"/>
      <Setter Property="Foreground" Value="#00FF41"/>
      <Setter Property="BorderBrush" Value="#12351D"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Explicit flat ListViewItem template prevents the Windows theme from applying a gradient hover. -->
    <Style TargetType="ListViewItem">
      <Setter Property="Background" Value="#000000"/>
      <Setter Property="Foreground" Value="#D2E0D6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="#0D2413" BorderThickness="0,0,0,1" Padding="2">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#061A0A"/>
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00A82B"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#09250E"/>
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#00FF41"/>
                <Setter Property="Foreground" Value="#E0FFE8"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="ItemBorder" Property="Background" Value="#0B3013"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#79D98E"/>
      <Setter Property="Background" Value="#010201"/>
      <Setter Property="BorderBrush" Value="#12351D"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" Margin="1,1,1,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#061A0A"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#00FF41"/>
                <Setter Property="Foreground" Value="#00FF41"/>
                <Setter Property="FontWeight" Value="Bold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#041008"/>
                <Setter Property="Foreground" Value="#00FF41"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="TabBorder" Property="Background" Value="#08260E"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Background="#000000">
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <Border Padding="18,9" Background="#000000" BorderBrush="#12351D" BorderThickness="0,0,0,1"><DockPanel><StackPanel><TextBlock Text="A2Z // SYSTEM INSPECTOR" Foreground="{StaticResource Green}" FontSize="22" FontWeight="Bold"/><TextBlock Text="PROPRIETARY TECHNICIAN DIAGNOSTIC CONSOLE  •  READ-ONLY SCREENING" Foreground="#467D53" FontSize="11" Margin="0,4,0,0"/></StackPanel><Border Background="#030A05" BorderBrush="#145A29" BorderThickness="1" CornerRadius="3" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="INTERNAL • A2Z ONLY" Foreground="#55D970" FontSize="11" FontWeight="Bold"/></Border></DockPanel></Border>

    <TabControl x:Name="Tabs" Grid.Row="1" Margin="10" Background="#000000" BorderBrush="#12351D" BorderThickness="1">
      <TabItem Header="[01] SESSION"><ScrollViewer Background="#000000" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid Margin="22" MaxWidth="800" HorizontalAlignment="Left" Background="#000000"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*" MinWidth="420"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Grid.ColumnSpan="2" Text="> initialize inspection session" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Green}" Margin="0,0,0,18"/><TextBlock Grid.Row="1" Text="customer/reference" Foreground="{StaticResource DimGreen}" VerticalAlignment="Center"/><TextBox x:Name="CustomerBox" Grid.Row="1" Grid.Column="1"/><TextBlock Grid.Row="2" Text="job number (optional)" Foreground="{StaticResource DimGreen}" VerticalAlignment="Center"/><TextBox x:Name="JobBox" Grid.Row="2" Grid.Column="1"/><TextBlock Grid.Row="3" Text="technician" Foreground="{StaticResource DimGreen}" VerticalAlignment="Center"/><TextBox x:Name="TechnicianBox" Grid.Row="3" Grid.Column="1"/><TextBlock Grid.Row="4" Text="reported problem" Foreground="{StaticResource DimGreen}" VerticalAlignment="Top" Margin="0,12,0,0"/><TextBox x:Name="ProblemBox" Grid.Row="4" Grid.Column="1" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/><StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="StartButton" Content="RUN INSPECTION" Click="Start_Click"/><TextBlock Text="admin elevation may be required for privileged sensors" Foreground="#467D53" VerticalAlignment="Center" Margin="14,0"/></StackPanel></Grid></ScrollViewer></TabItem>

      <TabItem Header="[02] LIVE CONSOLE"><Grid Margin="20" Background="#000000"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="> evidence acquisition" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Green}"/><ProgressBar x:Name="Progress" Grid.Row="1" Height="16" Margin="0,14,0,12" Minimum="0" Maximum="100" Background="#010201" Foreground="#00FF41"/><Border Grid.Row="2" Background="#000000" BorderBrush="#12351D" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="[console]" Foreground="#00FF41"/><TextBlock x:Name="ProgressText" Text="Ready" Foreground="#D4E6D9" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="No repair, cleanup, deletion, update or configuration change is performed by the automatic inspection." Foreground="#467D53" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border></Grid></TabItem>

      <TabItem Header="[03] EVIDENCE"><Grid Margin="16" Background="#000000"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#020402" BorderBrush="#145A29" BorderThickness="1" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OverallText" Text="No inspection completed" TextWrapping="Wrap" Foreground="{StaticResource Green}" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="InspectionIdText" Grid.Column="1" Margin="12,0,0,0" Foreground="#4D8A5A" VerticalAlignment="Center"/></Grid></Border><ListView x:Name="ResultsList" Grid.Row="1" Margin="0,10" Background="#000000" Foreground="#D2E0D6" BorderBrush="#12351D" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.View><GridView><GridViewColumn Header="EVIDENCE" Width="220" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="STATE" Width="175" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="INTERPRETATION / LIMITATION" Width="560" DisplayMemberBinding="{Binding Reason}"/></GridView></ListView.View></ListView><ScrollViewer Grid.Row="2" Background="#000000" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel><Button x:Name="RunStressButton" Content="CPU STAGED TEST" Click="Stress_Click"/><Button x:Name="CancelStressButton" Content="STOP TEST" Click="CancelStress_Click" IsEnabled="False" Background="#200808" Foreground="#FF6666" BorderBrush="#702020"/><Button Content="OPEN REPORT" Click="ViewReport_Click"/><Button Content="EXPORT JSON" Click="ExportJson_Click"/><Button Content="EXPORT LOG" Click="ExportLog_Click"/><Button Content="SAVE TEXT" Click="ExportText_Click"/><Button Content="NEW SESSION" Click="New_Click"/></WrapPanel></ScrollViewer></Grid></TabItem>

      <TabItem Header="[04] REPORT"><Grid Background="#000000"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Margin="12" Background="#000000" BorderBrush="#12351D" BorderThickness="1"><FlowDocumentScrollViewer x:Name="ReportViewer" Background="#000000" Foreground="#D5E3D8" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/></Border><WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="8"><Button x:Name="SavePdfButton" Content="SAVE PDF" Click="SavePdf_Click"/><Button Content="EXPORT JSON" Click="ExportJson_Click"/><Button Content="EXPORT LOG" Click="ExportLog_Click"/></WrapPanel></Grid></TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#000000" BorderBrush="#12351D" BorderThickness="0,1,0,0" Padding="12,6"><DockPanel><TextBlock x:Name="StatusText" Text="READY" Foreground="#00FF41" TextTrimming="CharacterEllipsis"/><TextBlock Text="v2.4 • Windows 7 / 10 / 11" HorizontalAlignment="Right" Foreground="#3F704A"/></DockPanel></Border>
  </Grid>
</Window>
