<Window x:Class="A2ZSysIns.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A2Z System Inspector" Width="1080" Height="680" MinWidth="760" MinHeight="500" Background="#EDF3F8" Foreground="#102A43" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border Padding="20,8"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#102A43" Offset="0"/><GradientStop Color="#1565C0" Offset="1"/></LinearGradientBrush></Border.Background><DockPanel><StackPanel><TextBlock Text="A2Z SYSTEM INSPECTOR" Foreground="White" FontSize="21" FontWeight="Bold"/><TextBlock Text="Evidence-based computer health screening" Foreground="#C7E0F4" FontSize="11"/></StackPanel><Border Background="#22FFFFFF" CornerRadius="14" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="READ ONLY • OFFLINE" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border></DockPanel></Border>
    <TabControl x:Name="Tabs" Grid.Row="1" Margin="12" Background="White" BorderBrush="#D7E2EC" BorderThickness="1">
      <TabItem Header="1  Inspection details"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid Margin="20" MaxWidth="760" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*" MinWidth="420"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="Start a new inspection" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock Grid.Row="1" Text="Customer / reference" VerticalAlignment="Center"/><TextBox x:Name="CustomerBox" Grid.Row="1" Grid.Column="1"/>
        <TextBlock Grid.Row="2" Text="Job number (optional)" VerticalAlignment="Center"/><TextBox x:Name="JobBox" Grid.Row="2" Grid.Column="1"/>
        <TextBlock Grid.Row="3" Text="Technician" VerticalAlignment="Center"/><TextBox x:Name="TechnicianBox" Grid.Row="3" Grid.Column="1"/>
        <TextBlock Grid.Row="4" Text="Reported problem" VerticalAlignment="Top" Margin="0,12,0,0"/><TextBox x:Name="ProblemBox" Grid.Row="4" Grid.Column="1" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="StartButton" Content="Start read-only inspection" Click="Start_Click"/><TextBlock Text="Some readings require administrator access." Foreground="DimGray" VerticalAlignment="Center" Margin="14,0"/></StackPanel>
      </Grid></ScrollViewer></TabItem>
      <TabItem Header="2  Progress"><ScrollViewer><StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="Inspection in progress" FontSize="22" FontWeight="SemiBold"/><ProgressBar x:Name="Progress" Height="20" Margin="0,20,0,10" Minimum="0" Maximum="100"/><TextBlock x:Name="ProgressText" Text="Ready" FontSize="15"/><TextBlock Text="The application only reads diagnostic information. It does not repair, delete, clean, update, or modify this computer." TextWrapping="Wrap" Foreground="DimGray" Margin="0,22,0,0"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="3  Results"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#EAF4FF" BorderBrush="#B8D8F5" BorderThickness="1" CornerRadius="8" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OverallText" Text="No inspection completed" TextWrapping="Wrap" Foreground="#102A43" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="InspectionIdText" Grid.Column="1" Margin="12,0,0,0" Foreground="#486581" VerticalAlignment="Center"/></Grid></Border><ListView x:Name="ResultsList" Grid.Row="1" Margin="0,12" Background="White" Foreground="#243B53" BorderBrush="#D7E2EC" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.View><GridView><GridViewColumn Header="Measurement" Width="210" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="Assessment" Width="185" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Evidence / limitation" Width="530" DisplayMemberBinding="{Binding Reason}"/></GridView></ListView.View></ListView><ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><WrapPanel><Button Content="View full report" Click="ViewReport_Click"/><Button Content="Export JSON evidence" Click="ExportJson_Click"/><Button Content="Download diagnostic log" Click="ExportLog_Click"/><Button Content="Save text summary" Click="ExportText_Click"/><Button Content="New inspection" Click="New_Click" Background="#526D82"/></WrapPanel></ScrollViewer></Grid></TabItem>
      <TabItem Header="4  Report"><Grid Background="#E8EEF3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Margin="22" Background="White" BorderBrush="#CBD8E3" BorderThickness="1"><FlowDocumentScrollViewer x:Name="ReportViewer" Background="White" Foreground="#172B4D" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"/></Border><WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="10"><Button Content="Print / Save as PDF" Click="Print_Click"/><Button Content="Export JSON evidence" Click="ExportJson_Click"/><Button Content="Download diagnostic log" Click="ExportLog_Click"/></WrapPanel></Grid></TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#E6EEF6" Padding="14,6"><DockPanel><TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis"/><TextBlock Text="Version 2.1 • Windows 7 / 10 / 11" HorizontalAlignment="Right" Foreground="DimGray"/></DockPanel></Border>
  </Grid>
</Window>
