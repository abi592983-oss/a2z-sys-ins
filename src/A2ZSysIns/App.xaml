<Application x:Class="A2ZSysIns.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Navy" Color="#102A43"/>
    <SolidColorBrush x:Key="Blue" Color="#1976D2"/>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,12,8"/><Setter Property="Padding" Value="8"/></Style>
  </Application.Resources>
</Application>
